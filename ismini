#!/bin/bash
# ismini — Web UI launcher: starts the server if not running, then opens the browser
URL="http://127.0.0.1:8787/"

# Check if the server is already running
if curl -s -m 1 "$URL" -o /dev/null; then
  xdg-open "$URL"
  exit 0
fi

# Detect Flatpak or regular install
if [ -d "/app/lib/ismini" ]; then
  # Running from Flatpak install — start the server directly from /app
  DIR="/app/lib/ismini"
else
  # Running from regular install (install.sh)
  DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# Start the server
# In Flatpak, sudo is not available — disable it
if [ -d "/app/lib/ismini" ]; then
  ISMINI_SUDO=false nohup node "$DIR/web.js" > /tmp/ismini.log 2>&1 &
else
  nohup node "$DIR/web.js" > /tmp/ismini.log 2>&1 &
fi

# Wait for the server to be ready (up to ~10s)
for _ in $(seq 1 20); do
  sleep 0.5
  curl -s -m 1 "$URL" -o /dev/null && break
done

xdg-open "$URL"
