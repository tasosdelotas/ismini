{
  "type": "fsmodel",
  "app_id": "org.ismini.app",
  "default_branch": "master",
  "modules": [
    {
      "name": "ismini",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 ismini $DESTDIR/app/bin/ismini",
        "install -Dm644 agent.js $DESTDIR/app/lib/ismini/agent.js",
        "install -Dm644 web.js $DESTDIR/app/lib/ismini/web.js",
        "install -Dm644 config.json $DESTDIR/app/lib/ismini/config.json",
        "install -Dm644 ismini.png $DESTDIR/app/share/icons/hicolor/256x256/apps/org.ismini.app.png",
        "install -Dm644 ismini.desktop $DESTDIR/app/share/applications/org.ismini.app.desktop",
        "install -Dm644 web/index.html $DESTDIR/app/lib/ismini/web/index.html",
        "install -Dm644 web/favicon-256.png $DESTDIR/app/lib/ismini/web/favicon-256.png",
        "install -Dm644 web/marble.jpeg $DESTDIR/app/lib/ismini/web/marble.jpeg",
        "install -Dm644 web/stars.gif $DESTDIR/app/lib/ismini/web/stars.gif",
        "install -Dm644 web/bg.jpg $DESTDIR/app/lib/ismini/web/bg.jpg",
        "cp -r web/fonts $DESTDIR/app/lib/ismini/web/fonts",
        "cp -r tools $DESTDIR/app/lib/ismini/tools"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/tasosdelotas/ismini.git",
          "branch": "main",
          "path": "src"
        }
      ]
    }
  ]
}
